NODE_ENV=development
PORT=3001
DATABASE_PATH=data/ticketing.sqlite
ATTACHMENTS_PATH=data/attachments
JWT_SECRET=replace-with-a-long-random-secret
SEED_AGENT_EMAIL=alex@relaysupport.test
SEED_AGENT_PASSWORD=Support123!
SEED_AGENT_NAME=Jishnu Infotech Admin
SEED_CUSTOMER_EMAIL=sam@northstar.test
SEED_CUSTOMER_PASSWORD=Customer123!
SEED_CUSTOMER_NAME=Company Administrator
SEED_CUSTOMER_COMPANY=Initial Client Company

# Public URL used in password-reset and agent-invitation links.
APP_BASE_URL=http://localhost:5173

# Outbound mail for agent replies, account recovery, and team invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_MESSAGE_ID_DOMAIN=support.jishnuinfotech.com

# Optional Gmail/Google Workspace inbound support mailbox (IMAP must be enabled).
# For accounts that require it, use a mailbox-specific app password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_MS=30000
