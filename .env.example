NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/jishnu_support
ATTACHMENTS_PATH=data/attachments
JWT_SECRET=replace-with-a-long-random-secret
# Username used for the first Super Admin. Email/contact are optional.
SEED_CONSULTANT_USERNAME=JIT_Admin
SEED_CONSULTANT_EMAIL=
SEED_CONSULTANT_PASSWORD=
SEED_CONSULTANT_NAME=Jishnu Infotech Super Admin
SEED_CONSULTANT_CONTACT_NUMBER=

# Public URL used by optional email workflows (password recovery/invitations).
APP_BASE_URL=http://localhost:5173

# Optional outbound mail for Consultant replies, account recovery, and invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_MESSAGE_ID_DOMAIN=support.jishnuinfotech.com

# Optional Gmail/Google Workspace inbound support mailbox (IMAP must be enabled).
# For accounts that require it, use a mailbox-specific app password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_MS=30000
